EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-project-number
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id

# Solo para desarrollo. Requiere Stripe en modo de prueba y un backend configurado.
EXPO_PUBLIC_STRIPE_TEST_CHECKOUT_ENABLED=false

# Opcional: servidor Stripe externo/local que usa Auth y Firestore en línea con Spark.
# En Expo Go usa la IP LAN de la computadora. Si no se define, se usa Cloud Functions.
# EXPO_PUBLIC_STRIPE_TEST_BACKEND_URL=http://192.168.1.50:4242

# Alternativa aislada: host local de los emuladores. No lo combines con el backend en línea.
# Usa 127.0.0.1 en web, 10.0.2.2 en emulador Android o la IP LAN de tu PC en un teléfono.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.50
