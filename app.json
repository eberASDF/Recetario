{
  "expo": {
    "name": "Recetario",
    "slug": "recetario",
    "version": "1.0.0",
    "scheme": "recetario",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4EC",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EC",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite a Recetario tomar tu foto de perfil.",
          "photosPermission": "Permite a Recetario elegir una foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite a Recetario verificar tu identidad con Face ID para continuar."
        }
      ]
    ]
  }
}
